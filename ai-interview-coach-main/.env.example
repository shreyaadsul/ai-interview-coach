# API Keys for AI Engines
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Database Configuration (Defaults to local MongoDB in development)
MONGO_URI=mongodb://localhost:27017

# Production settings
PORT=5000
FLASK_DEBUG=True

# CORS Origin Allowed (Set to your Vercel URL in production, e.g. https://your-domain.vercel.app)
# You can use a comma-separated list to allow multiple origins.
FRONTEND_URL=http://localhost:5173
